# Copy this file to .env and provide a unique secret key.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.100.5,schematic-revenge-unvarying.ngrok-free.dev
